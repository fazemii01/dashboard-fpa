{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev -p 8200",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start -p 8200",
    "lint": "node node_modules/next/dist/bin/next lint",
    "postinstall": "node -e \"try { const fs = require('fs'), p = require('path'), b = p.join('node_modules', '.bin'); if (fs.existsSync(b)) fs.readdirSync(b).forEach(f => { try { fs.chmodSync(p.join(b, f), 0o755); } catch(e){} }); } catch(e){}\""
  },
  "dependencies": {
    "@nextui-org/react": "2.0.22",
    "apexcharts": "^3.35.5",
    "clsx": "^2.0.0",
    "formik": "^2.4.6",
    "framer-motion": "^10.16.0",
    "next": "^14.0.4",
    "next-themes": "0.2.1",
    "react": "18.2.0",
    "react-apexcharts": "^1.4.0",
    "react-dom": "18.2.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "18.7.18",
    "@types/react": "18.0.20",
    "@types/react-dom": "18.0.6",
    "autoprefixer": "^10.4.15",
    "eslint": "8.23.1",
    "eslint-config-next": "13.4.16",
    "postcss": "^8.4.28",
    "tailwindcss": "^3.3.3",
    "typescript": "4.8.3"
  }
}
